{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Module Metadata",
  "description": "Metadata file for a data module. Place this in raw/{module_id}/metadata.json",
  "type": "object",
  "required": [
    "module_id",
    "module_name",
    "owner",
    "datasets"
  ],
  "properties": {
    "module_id": {
      "type": "string",
      "description": "Unique lowercase identifier (matches module JS file name)"
    },
    "module_name": {
      "type": "string",
      "description": "Human-readable module name"
    },
    "owner": {
      "type": "string",
      "description": "Team member responsible for this module"
    },
    "created": {
      "type": "string",
      "format": "date",
      "description": "Date module was created (YYYY-MM-DD)"
    },
    "datasets": {
      "type": "array",
      "description": "List of datasets in this module",
      "items": {
        "type": "object",
        "required": [
          "dataset_name",
          "source_name",
          "source_url",
          "download_date",
          "update_frequency",
          "years_covered",
          "owner_agency",
          "license"
        ],
        "properties": {
          "dataset_name": {
            "type": "string",
            "description": "Descriptive name of the dataset"
          },
          "source_name": {
            "type": "string",
            "description": "Official name of the data source"
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "description": "URL where the data was downloaded from"
          },
          "download_date": {
            "type": "string",
            "format": "date",
            "description": "Date the data was downloaded (YYYY-MM-DD)"
          },
          "update_frequency": {
            "type": "string",
            "enum": ["Daily", "Weekly", "Monthly", "Quarterly", "Annual", "Biennial", "Decennial", "As needed"],
            "description": "How often the source data is updated"
          },
          "years_covered": {
            "type": "string",
            "description": "Time range of the data (e.g. '2020-2023', '1976-Present')"
          },
          "owner_agency": {
            "type": "string",
            "description": "Government agency that publishes the data"
          },
          "license": {
            "type": "string",
            "description": "Data license (typically 'Public Domain' for government data)"
          },
          "description": {
            "type": "string",
            "description": "Brief description of what the dataset contains"
          },
          "checksum_sha256": {
            "type": "string",
            "description": "SHA-256 checksum of the raw file for integrity verification"
          },
          "file_format": {
            "type": "string",
            "enum": ["csv", "json", "parquet", "geojson", "shapefile", "txt", "dat", "zip"],
            "description": "Format of the raw file"
          },
          "file_size_bytes": {
            "type": "integer",
            "description": "Size of the raw file in bytes"
          }
        }
      }
    }
  }
}
